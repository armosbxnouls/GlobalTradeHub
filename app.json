{
  "expo": {
    "name": "GlobalTradeHub",
    "slug": "globaltradehub",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F1B2D"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.yourcompany.globaltradehub",
      "infoPlist": {
        "NSCameraUsageDescription": "GlobalTradeHub uses the camera for video calls with other companies.",
        "NSMicrophoneUsageDescription": "GlobalTradeHub uses the microphone for audio and video calls with other companies."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0F1B2D"
      },
      "package": "com.yourcompany.globaltradehub",
      "permissions": ["CAMERA", "RECORD_AUDIO", "INTERNET"]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
